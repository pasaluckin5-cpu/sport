{
  "expo": {
    "name": "SwimPlanner",
    "slug": "swimplanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "swimplanner",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.swimflow.swimplanner",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSBluetoothAlwaysUsageDescription": "Приложению требуется доступ к Bluetooth для подключения к устройствам."
      }
    },
    "android": {
      "package": "com.swimflow.swimplanner",
      "adaptiveIcon": {
        "backgroundColor": "#063B7A",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "11b6d7e0-0bc9-4c9c-ae20-9458dba8a25e"
      }
    }
  }
}
