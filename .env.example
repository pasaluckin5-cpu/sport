# Copy this file to .env and fill in your own Supabase project's values
# (Project Settings -> API in the Supabase dashboard). These are NOT secrets — the anon key is
# meant to ship in client code, since access is governed entirely by the Row Level Security
# policies in supabase/migrations/, not by hiding this value. See docs/supabase-architecture.md.
#
# Never put the "service_role" key here or anywhere in this repo — it bypasses RLS entirely.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
